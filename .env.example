# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:your-local-password@127.0.0.1:5432/food_connect
POSTGRES_URL=postgresql://postgres:your-local-password@127.0.0.1:5432/food_connect
SUPABASE_URL=https://lmbfbwrkujsckptyvuvj.supabase.co
SUPABASE_ANON_KEY=your-project-anon-key

# Public browser configuration for Vite. Use the project's anon key, never its service-role key.
VITE_SUPABASE_URL=https://lmbfbwrkujsckptyvuvj.supabase.co
VITE_SUPABASE_ANON_KEY=your-project-anon-key

# Set these as Supabase Edge Function secrets for production; do not use VITE_ prefixes.
# For local Express development, configure them in FoodZa's .env. The shared secret
# must match FOODZA_OTP_API_SECRET in the YouPI payment API environment.
YOUPI_OTP_API_URL=
# Must match YouPI's FOODZA_OTP_API_SECRET and be kept server-side only.
FOODZA_OTP_API_SECRET=
YOUPI_CHECKOUT_URL=http://127.0.0.1:7000
YOUPI_API_KEY=your-youpi-merchant-api-key
YOUPI_WEBHOOK_SECRET=your-youpi-webhook-secret

# Authentication Configuration (FoodZa JWT & Sessions)
JWT_ACCESS_SECRET=your-random-32-byte-hex-secret
JWT_ACCESS_EXPIRY=15m

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend API base (use /api for local server or your deployed backend URL)
VITE_API_BASE=/api
